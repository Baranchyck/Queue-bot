BOT_TOKEN=123456:replace-me

# Локально (docker-compose). Для Neon встав рядок підключення як є —
# config.py сам приведе його до формату asyncpg.
DATABASE_URL=postgresql+asyncpg://queue:queue@localhost:5432/queue

# polling — локально, webhook — на Render
MODE=polling

# Тільки для MODE=webhook
WEBHOOK_URL=https://your-service.onrender.com
WEBHOOK_SECRET=change-me-long-random-string
PORT=8080

# Кількість місць у черзі
SLOTS_COUNT=19
